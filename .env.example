PUBLIC_ORIGIN=https://tools.opskoo.com
# Generate with: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
LAB_ACCESS_CODE=replace-with-a-random-access-code-at-least-32-characters
COOKIE_SECURE=true
# Backend-only VNPT credentials. Never include them in HTML/JS or commit them.
# These configure OCR/Oval only. IDCheck and VNeID/C06 are not integrated yet;
# do not reuse these tokens or add guessed provider URLs to enable those tabs.
VNPT_TOKEN_ID=
VNPT_TOKEN_KEY=
VNPT_ACCESS_TOKEN=
# ReadID Ready: separate Signicat sandbox account. No production calls supported.
# Enable only after the account has Assure API and ReadID Ready permissions.
SIGNICAT_NFC_ENABLED=false
SIGNICAT_CLIENT_ID=
SIGNICAT_CLIENT_SECRET=
SIGNICAT_CAPTURE_DOMAIN=
